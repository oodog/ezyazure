{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyazure.microsoft/skills/skill-bundle.schema.json",
  "title": "EasyAzure product skill bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleVersion", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "bundleVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.skill\\.json$"
      }
    }
  }
}